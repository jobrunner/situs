# build output
/situs
/dist/

# test + coverage output
/coverage/
*.test
*.out

# MkDocs build output
/site/

# local index + WAL sidecars
*.sqlite
*.sqlite-wal
*.sqlite-shm

# pinned source artifacts are fetched, never committed
/pipelines/*/artifacts/

# Python pipeline byte-compiled caches
__pycache__/
*.pyc

# IDE / local environment
.idea/
.vscode/
.env
.envrc.local

# keep the vendored skill symlinks under version control
.claude/*
!.claude/skills
!.claude/skills/**
