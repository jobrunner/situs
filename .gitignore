# build output
/situs
/dist/

# test + coverage output
/coverage/
*.test
*.out

# MkDocs build output
/site/

# local index + WAL sidecars, und die Sicherungskopien davon: ein Index ist
# ein wiederherstellbares Artefakt, kein Repo-Inhalt
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite.bak*

# das gesammelte Ingest-Eingabeverzeichnis (make ingest-input) und alles
# andere unter out/: erzeugt, nie eingecheckt
/out/

# pinned source artifacts are fetched, never committed; pipeline output is
# generated from them and never committed either
/pipelines/*/artifacts/
/pipelines/*/out/
/pipelines/*/.cache/
/pipelines/*/output/
/pipelines/*/*.summary.txt

# Python pipeline byte-compiled caches
__pycache__/
*.pyc

# IDE / local environment
.idea/
.vscode/
.env
.envrc.local

# keep the vendored skill symlinks under version control
.claude/*
!.claude/skills
!.claude/skills/**
# ... und die Projektkonfiguration, die fuer alle gelten soll. Ohne diese
# Ausnahmen nimmt "git add -A" sie stillschweigend nicht mit: der Hook lag
# lokal und war gleichzeitig in CLAUDE.md als geltend beschrieben.
!.claude/settings.json
!.claude/hooks
!.claude/hooks/**

# Browser-Automation-Artefakte (Playwright-MCP), nie Teil des Repos
/.playwright-mcp/

# Agenten-Arbeitsverzeichnis: bisher nur global ausgeschlossen, damit hätte ein
# `git add -A` auf einer anderen Maschine oder in CI alles davon eingecheckt
/.superpowers/

# Dieser Spike bleibt bewusst unversioniert; die beiden älteren Spikes unter
# docs/research/ sind und bleiben getrackt
/docs/research/2026-08-20-verbreitungsfilter-spike.md

# CodeCharta-Analyse-Ausgaben (make codecharta) — die Map wird bei jedem Lauf
# neu erzeugt; versioniert ist nur der Ratchet (.codecharta-ratchet.json)
*.cc.json
*.cc.json.gz
coverage.info
coverage.out
.worktrees/
