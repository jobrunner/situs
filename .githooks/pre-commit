#!/usr/bin/env bash
# situs pre-commit hook. Fast and non-mutating, so a broken or unformatted state
# does not get committed. Install with: make hooks
#
# Deliberately lightweight (gofmt check + compile + the grep-fast debt ratchet).
# The full gate is `make verify` / CI, which adds lint and the coverage floors —
# those need a test run and are too slow here. Skip with: git commit --no-verify
set -euo pipefail

# git may invoke the hook from a subdirectory, but ./scripts and `go build ./...`
# assume the repository root.
cd "$(git rev-parse --show-toplevel)" || exit 1

# Only act when Go files are staged. NUL-delimited so paths with spaces survive.
staged=$(git diff --cached --name-only --diff-filter=ACM -z -- '*.go' | tr '\0' '\n')
if [ -z "$staged" ]; then
	exit 0
fi

unformatted=$(gofmt -l cmd internal)
if [ -n "$unformatted" ]; then
	echo "pre-commit: not gofmt-clean:" >&2
	echo "$unformatted" >&2
	echo "  run: make fmt" >&2
	exit 1
fi

go build ./...
./scripts/debt-guard.sh
